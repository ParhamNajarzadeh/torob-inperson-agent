# ==============================================================================
# پیکربندی محیطی دستیار هوشمند خرید حضوری ترب (بدون هیچ کلید هاردکدشده)
# برای داوران محترم: صرفاً کلید METIS_API_KEY را وارد کرده و docker compose up بزنید
# ==============================================================================

# ۱. هویت مجازی ایجنت و حاکمیت (AI Governance - فصل ۱۶ کوئرا)
AGENT_VIRTUAL_USER_ID=service_account:torob-inperson-agent-v1
AGENT_TOKEN_EXPIRES_AT=2026-11-01T23:59:59+03:30
AGENT_KILL_SWITCH_SECRET=change_me_in_production_admin_secret

# ۲. لایه اول: مدل زایشی و ابزارمحور (deepseek-v4.1-flash از طریق پراکسی متیس)
METIS_API_KEY=your_metis_api_key_here
METIS_BASE_URL=https://api.metisai.ir/deepseek/v1
METIS_OPENAI_COMPAT_URL=https://api.metisai.ir/openai/v1
LLM_MODEL_NAME=deepseek-v4.1-flash
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_CACHE_TTL=5m

# ۳. لایه دوم: دروازه تصمیمگیری System-1 (metis_jev | local_mizan_4b | local_kev | local_laya)
SYSTEM_ONE_PROVIDER=metis_jev
METIS_TYPESAFE_URL=https://api.metisai.ir/api/v1/wrapper/typesafe/v1/systemone
SYSTEM_ONE_MODEL=jev-latest
LOCAL_MIZAN_URL=http://localhost:8008/v1/systemone
LOCAL_KEV_URL=http://localhost:8009/v1/systemone
LOCAL_LAYA_MODEL=multilingual

# ۴. مسیر دیتاست ترب و دیتابیس Read-Only کاتالوگ
TOROB_RAW_DATA_DIR=./data/raw
TOROB_DUCKDB_PATH=./data/indexed/torob_catalog.duckdb
TOROB_DB_READONLY=true

# ۵. مشاهدهپذیری و ردیابی (Observability - فصل ۱۵ کوئرا)
TRACE_LOG_PATH=./memory/trace/trace.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ۶. پورتهای اجرایی فرانتاند و بکاند
BACKEND_PORT=8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
